---
const info = {
	"Культурные мероприятия": [
		{ expert: "Организация этнических массовых праздников и гуляний", emodji: "🎉" },
		{ expert: "Организация различных тематических конкурсов и фестивалей", emodji: "🏆" },
		{
			expert:
				"Приглашение и организация концертов и выступлений известных татарских и башкирских артистов",
			emodji: "🎶",
		},
	],
	"Молодежные и детские мероприятия": [
		{
			expert:
				"Проведение флэш-мобов, тусовок, пати, дискотек и прочих молодежных и детских мероприятий.",
			emodji: "💃🕺",
		},
	],
	"Содействие в адаптации": [
		{
			expert:
				"Содействие татарам и башкирам, впервые прибывшим в город, в трудоустройстве и первичной адаптации.",
			emodji: "🤝",
		},
		{
			expert: "Представление интересов татар и башкир на различных мероприятиях.",
			emodji: "🌍",
		},
	],
	"Интеграция и социальная поддержка": [
		{
			expert:
				"Оказание содействия в семейном образовании и поиске сторон для Небесного союза.",
			emodji: "💑",
		},
		{
			expert:
				"Организация и предоставление места для проведения обрядов венчания (никах) и погребения.",
			emodji: "🕌",
		},
	],
	"Туристическая и гостевая поддержка": [
		{
			expert:
				"Знакомство гостей города с местными достопримечательностями в рамках культурно-социальных программ.",
			emodji: "🏛️",
		},
		{
			expert: "Организация приема, размещения, экскурсий и посещений различных мест.",
			emodji: "🗺️",
		},
	],
	"Представительство и участие": [
		{
			expert:
				"Представление татар и башкир на различных междугородних, республиканских, и международных мероприятиях.",
			emodji: "🌐",
		},
	],
	Разное: [
		{
			expert:
				"Дополнительные инициативы и деятельность, направленные на пользу движения и филиала.",
			emodji: "🌟",
		},
	],
}
---

<section id="about" class="max-w-[880px] prose mx-auto prose-lg prose-sky">
	<h2>Что такое татарский центр «Идел»?</h2>
	<p><b>(как нас часто называют)</b>, и для чего всё это нужно.</p>
	<p>
		Татарский центр «Идел» это Алматинский филиал Республиканского Общественного
		Объединения «Ассоциация татарских и татаро-башкирских общественных и культурных
		центров «Идел».
	</p>
	<p>
		Головной офис Ассоциации, управляемый президентом Ассоциации гос. Ишмуратовым Г.Р.,
		находится в г. Астана.
	</p>
</section>

<d class="flex flex-col gap-20 max-w-[880px] mx-auto">
	{
		Object.entries(info).map(([category, items]) => (
			<div class="flex flex-col gap-5">
				<h4 class="self-start px-5 py-2 rounded-2xl bg-blue-50 text-blue-700 font-medium">
					{category}
				</h4>
				<div class="grid gap-5 items-start md:grid-cols-2">
					{items.map(item => (
						<article class="flex items-center gap-5 p-5 bg-zinc-50 rounded-lg">
							<span class="text-2xl items-center">{item.emodji}</span>
							<p class="text-lg leading-tight text-zinc-700">{item.expert}</p>
						</article>
					))}
				</div>
			</div>
		))
	}
</d>
