---
import StyleBox from "./partials/StyleBox.astro";

const info = {
	"Культурные мероприятия": {
		items: [
			{ expert: "Организация этнических массовых праздников и гуляний", emodji: "🎉" },
			{ expert: "Организация различных тематических конкурсов и фестивалей", emodji: "🏆" },
		],
		hr: true,
	},

	"Мероприятия и праздники": {
		items: [
			{
				expert: "Сабантуй и другие праздники",
				emodji: "🎉",
			},
			{
				expert: "Мероприятия для молодежи",
				emodji: "💃🕺",
			},
			{
				expert: "Мероприятия для всех желающих",
				emodji: "👨‍👩‍👧‍👦",
			},
			{
				expert: "Мастер классы и семинары",
				emodji: "🎓",
			},
		],
		hr: true,
	},

	"Содействие в адаптации": {
		items: [
			{
				expert: "Представление интересов татар и башкир на различных мероприятиях.",
				emodji: "🌍",
			},
		],
		hr: true,
	},

	"Представительство и участие": {
		items: [
			{
				expert:
					"Представление татар и башкир на различных междугородних, республиканских и международных мероприятиях.",
				emodji: "🌐",
			},
		],
		hr: true,
	},

	Разное: {
		items: [
			{
				expert:
					"Дополнительные инициативы и деятельность, направленные на пользу центра и молодежной/взрослой группы.",
				emodji: "🌟",
			},
		],
		hr: false,
	},
};
---

<section id="about" class="max-w-220 prose mx-auto prose-lg prose-blue">
	<h2>Что такое татарский центр «Идел»?</h2>
	<p>
		Татарский центр «Идел» это Алматинский филиал Республиканского Общественного Объединения
		«Ассоциация татарских и татаро-башкирских общественных и культурных центров «Идел».
	</p>
	<p>
		Головной офис Ассоциации, управляемый президентом Ассоциации гос. Ишмуратовым Г.Р.,
		находится в г. Астана.
	</p>
	
</section>

<section class="flex flex-col gap-5 max-w-220 mx-auto">
	{
		Object.entries(info).map(([title, section]) => (
			<section class="flex flex-col gap-6">
				<h3 class="text-2xl font-bold text-center tracking-tight">{title}</h3>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					{section.items.map((item) => (
						<article
							class={`flex items-center gap-5 p-5 ring-[0.4px] ring-inset ring-zinc-400/60 bg-zinc-50 rounded-4xl corner-squircle ${
								section.items.length === 1 ? "md:col-span-2" : ""
							}`}
						>
							<span class="text-2xl">{item.emodji}</span>
							<p class="text-lg leading-tight text-zinc-700">{item.expert}</p>
						</article>
					))}
				</div>

				{section.hr && <div class="h-25 w-px mx-auto bg-zinc-400 my-0" />}
			</section>
		))
	}
</section>

<StyleBox variant="light" outClassFirst="max-w-220 -mx-5 md:mx-auto" innerClass="p-5 md:p-10">
	<section class="max-w-fullprose prose-lg prose-blue">
		<h3 class="font-bold tracking-tight">И, конечно, главное!</h3>
		<p>Видеть приходящих к нам татар и башкир счастливыми.</p>

		<p>
			Потому что, в конечном счете, и язык, и музыка, и литература, и культура и различные
			тематические мероприятия это только средства. Средства для достижения истинной цели.
		</p>
		<p>
			<b>Сама же цель</b> - это образованный, традиционно-воспитанный на принципах Кона, здоровый
			телесно и духовно, инициативно-мыслящий и обладающий гармоничным мировосприятием нравственно
			богатый и живущий в финансовом достатке татарин или татарка.
		</p>
		<p>
			<b>
				И как же нам добиться/достичь этого? До очень просто. Через сохранения института семьи.
				Традиционной трехпоколенной, почитающей - и знающей! - свой Род и Традиции.
			</b>
		</p>
		<p>
			Ибо только в семье и взращивается такой человек, о котором сказано выше. Ни школа, ни
			телевизор, ни интернет, ни няньки, ни тётки чужие, ни интернат не смогут этого сделать,
			как не смогли раньше, и никогда не смогут позже.
		</p>
		<p>
			Потому что воспитание идет не от слов, а от дел. От наполнения матерью ребенка
			качествами, а от отца - правилами, структурами и формами..
		</p>

	

		<p>
			<b>Приглашаем к нам 🤗</b>
			<br />
			И с вашими идеями и с Вашими проблемами. <br />
			<b>Первые будем воплощать, а вторые – решать!</b>
		</p>
	</section>
</StyleBox>
