---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import FormattedDate from "./FormattedDate.astro"

const { data, slug } = Astro.props
---

<a
	href={`/posts/${slug}`}
	class="shrink-0 snap-center max-w-[310px] md:max-w-full group overflow-hidden rounded-2xl"
>
	<article class="relative">
		<Image
			src={data.heroImage}
			width={1200}
			height={1200}
			alt={`Изображение к посту: ${data.title}`}
			format="avif"
			class="group-hover:scale-[1.025] duration-500 transition-transform ease-out object-cover h-[220px] rounded-2xl"
		/>
		<div
			class="absolute bottom-0 p-5 w-full bg-gradient-to-tr from-black/50 to-white/10 rounded-2xl text-white backdrop-blur-sm backdrop-brightness-75 flex flex-col gap-2"
		>
			<h3 class="font-bold leading-tight text-lg line-clamp-2">{data.title}</h3>

			<FormattedDate date={data.pubDate} />
			<span
				class="group-hover:translate-y-0 group-hover:opacity-100 opacity-0 translate-y-10 absolute bottom-5 right-5 ease-in-out transition-all text-sm flex gap-1 items-center"
				>Далее <Icon name="mdi:arrow-right-bold" /></span
			>
		</div>
	</article>
</a>
