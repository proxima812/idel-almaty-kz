---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";

const { data, id } = Astro.props;
---

<a href={`/posts/${id}`} class="group overflow-hidden rounded-2xl">
	<article class="relative">
		{
			data.heroImage ? (
				<Image
					src={data.heroImage}
					alt={`Изображение к посту: ${data.title}`}
					format={"avif"}
					width={635}
					height={635}
					quality="low"
					class="group-hover:scale-[1.025] duration-500 transition-transform ease-out object-cover object-top bg-gray-100 h-55 rounded-2xl"
				/>
			) : (
				<div class="w-full bg-linear-to-br from-zinc-100  to-zinc-400 h-55" />
			)
		}
		<div
			class="absolute bottom-0 p-3 w-full bg-linear-to-t from-black/80 to-zinc-500/70 rounded-xl text-white backdrop-blur-sm backdrop-brightness-75 flex flex-col gap-2"
		>
			<h3 class="font-bold leading-tight text-lg line-clamp-2">
				{data.title}
			</h3>
			<FormattedDate date={data.pubDate} />
			<span
				class="group-hover:translate-y-0 group-hover:opacity-100 opacity-0 translate-y-10 absolute bottom-3 font-semibold duration-300 right-3 ease-in-out transition-all text-sm flex gap-1 items-center"
				>Подробнее <Icon name="mdi:star-four-points-outline" /></span
			>
		</div>
	</article>
</a>
