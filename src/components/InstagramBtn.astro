---
import { cn } from "@/utils/cn";
import Inst from "./Icons/Inst.astro";

const { class: className = "", href } = Astro.props;
---

<a
	class={cn(
		"self-start font-medium flex items-center gap-2 px-3 py-2 rounded-xl bg-pink-50 text-pink-700 hover:bg-pink-100 transition-colors",
		className,
	)}
	aria-label="Instagram Идел"
	target="_blank"
	href={href ?? "#"}
>
	<Inst />
	<span>{href ? href.replace("https://www.instagram.com/", "@") : "Не указан"}</span>
</a>
