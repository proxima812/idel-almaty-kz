---
/**
 * Встраивание поста/рилса Instagram. Пока embed.js не загрузился
 * (или заблокирован), видна аккуратная ссылка-заглушка.
 */
import { Icon } from "astro-icon/components";

interface Props {
	url: string;
}

const { url } = Astro.props;
const permalink = url.split("?")[0];
---

<div class="my-3 flex justify-center">
	<blockquote
		class="instagram-media w-full max-w-135 min-w-[326px] overflow-hidden rounded-3xl bg-white ring-1 ring-black/5"
		data-instgrm-captioned
		data-instgrm-permalink={`${permalink}?utm_source=ig_embed&utm_campaign=loading`}
		data-instgrm-version="14"
	>
		<a
			href={permalink}
			target="_blank"
			rel="noopener noreferrer"
			class="flex flex-col items-center gap-3 px-6 py-16 text-center text-sm font-medium text-zinc-600 no-underline"
		>
			<Icon name="mdi:instagram" class="text-4xl text-pink-600" />
			Смотреть в Instagram
		</a>
	</blockquote>
</div>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
