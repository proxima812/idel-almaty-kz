---
import { Icon } from "astro-icon/components";
import FormattedDate from "./FormattedDate.astro";
import StyleBox from "./partials/StyleBox.astro";

const { data, id } = Astro.props;
---

<StyleBox variant="gray" innerClass="p-6" outClassFirst="max-w-none">
	<a href={`/posts/${id}`} title={data.title}>
		<article class="flex flex-col gap-3 justify-between">
			<div>
				<h3 class="mb-2 h-22.5 font-bold leading-tight text-2xl line-clamp-3">
					{data.title}
				</h3>
				<FormattedDate date={data.pubDate} />
			</div>
			<span
				class="self-end inline-flex items-center gap-1 justify-end ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 py-1 px-2.5 text-sm animate-buttonheartbeat rounded-md bg-linear-to-br from-zinc-800 to-black/90 hover:opacity-90 font-medium text-white"
				><Icon name="mdi:star-four-points-outline" /><span>Подробнее</span></span
			>
		</article>
	</a>
</StyleBox>
