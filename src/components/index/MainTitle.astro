---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const latestPost = (await getCollection("posts"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))[0];
---

<div class="flex flex-col items-center gap-8">
	{
		latestPost && (
			<a
				href={`/posts/${latestPost.id}/`}
				class="group inline-flex max-w-full items-center gap-2 rounded-full bg-white py-1 pr-2.5 pl-1 text-sm shadow-[0_1px_2px_0_#0000000d] ring-1 ring-zinc-900/8 transition hover:shadow-[0_4px_12px_-4px_#0000001f] hover:ring-zinc-900/12"
			>
				<span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-600/15">
					<Icon name="mdi:creation" class="text-sm" />
					Новое
				</span>
				<span class="truncate text-zinc-700 group-hover:text-zinc-900">{latestPost.data.title}</span>
				<Icon
					name="mdi:arrow-right"
					class="shrink-0 text-zinc-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-zinc-700"
				/>
			</a>
		)
	}

	<h1 class="text-center text-4xl leading-tight font-extrabold md:text-6xl">
		<span>Татаро-Башкирский</span>{" "}
		<span class="font-black">«Идел»</span>
	</h1>
</div>
