---
import { Icon } from "astro-icon/components";

type Props = {
	href?: string;
	title?: string;
	class?: string;
};

const { href, title, class: className, ...attrs } = Astro.props as Props;
const isExternal = href ? /^https?:\/\//.test(href) : false;
const normalizedHref = href?.toLowerCase() ?? "";

const linkType = normalizedHref.includes("instagram.com")
	? "instagram"
	: normalizedHref.includes("youtube.com") || normalizedHref.includes("youtu.be")
		? "youtube"
		: normalizedHref.includes("2gis.")
			? "map"
			: isExternal
				? "external"
				: "internal";

const iconNameByType = {
	instagram: "mdi:instagram",
	youtube: "mdi:youtube",
	map: "mdi:map-marker",
	external: "mdi:open-in-new",
	internal: "mdi:link-variant",
};
---

<a
	href={href}
	title={title}
	target={isExternal ? "_blank" : undefined}
	rel={isExternal ? "noopener noreferrer" : undefined}
	class:list={[
		"inline-flex items-center gap-1 underline decoration-zinc-900/25 underline-offset-[3px] transition-colors hover:decoration-zinc-900",
		className,
	]}
	data-link-type={linkType}
	{...attrs}
>
	<Icon name={iconNameByType[linkType]} class="size-[1em] shrink-0 text-zinc-400" aria-hidden="true" />
	<slot />
</a>
