---
type Props = {
	class?: string;
};

const { class: className, ...attrs } = Astro.props as Props;
---

<blockquote
	class:list={[
		"my-8 rounded-2xl border-l-4 border-orange-500 bg-orange-50/80 px-5 py-4 text-zinc-800 shadow-sm [&>p:first-child]:mt-0 [&>p:last-child]:mb-0 [&_a]:text-orange-800",
		className,
	]}
	{...attrs}
>
	<slot />
</blockquote>
