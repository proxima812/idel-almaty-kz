---
import { Icon } from "astro-icon/components"

const { container_max_w } = Astro.props
---

<footer class="bg-blue-50 py-6">
	<div
		class:list={`${
			container_max_w ?? "max-w-6xl"
		} flex justify-center flex-wrap gap-3  md:gap-12 items-center container mx-auto px-5`}
	>
		<span class="text-center italic font-medium">
			(с) 2024 Ассоциация Татарских и Татаро-Башкирских Общественных и Культурных Центров
			«ИДЕЛ» по г. Алматы.
		</span>
		<a
			href="https://t.me/Kamil_mirikhan"
			class="text-blue-700 ring-1 ring-inset ring-blue-200 bg-blue-100 rounded-xl px-3 py-1.5
     flex gap-1 items-center"
		>
			<Icon name="mdi:account" />
			Насчет сайта</a
		>
	</div>
</footer>
