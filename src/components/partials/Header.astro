---
import logo from "@/assets/svg/idel-logo.svg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Menu from "../Menu/Menu.astro";
import Container from "./Container.astro";
---

<header id="header" class="py-5">
	<Container class="flex justify-between items-center">
		<a href="/">
			<Image
				id="img"
				src={logo}
				width={45}
				height={45}
				alt="Логотип idel-almaty.kz"
				title="Логотип"
				aria-label="Изображение"
			/>
		</a>
		<Menu class="justify-between">
			<div class="flex items-center ml-16 gap-5">
				<a
					href="/contacts"
					title=""
					class="text-zinc-800 flex items-center gap-1 transition-colors hover:text-zinc-600"
				>
					<Icon class="text-violet-500" name="mdi:message-badge" />
					<span>Контакты</span>
				</a>
				<a
					href="/gallery"
					title=""
					class="text-zinc-800 flex items-center gap-1 transition-colors hover:text-zinc-600"
				>
					<Icon class="text-violet-500" name="mdi:view-grid" />
					<span>Активисты | Галерия</span>
				</a>
			</div>
		</Menu>
	</Container>
</header>
