---
import SEO from "@/components/SEO.astro"
import Footer from "@/components/partials/Footer.astro"
import Header from "@/components/partials/Header.astro"
import "@/styles/global.css"
import { ViewTransitions } from "astro:transitions"

interface Props {
	index?: any
	name?: string
	title: string
	type?: any
	description?: string
	heroImage?: string
	locale?: string
	tags?: any
	canonicalURL?: any
	container_max_w?: string
}

const {
	index,
	name,
	title,
	type,
	description,
	heroImage,
	locale = "ru",
	tags,
	container_max_w,
	canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
	<SEO
		index={index}
		title={title}
		description={description}
		name={name}
		type={type}
		heroImage={heroImage}
		locale={locale}
		tags={tags}
		canonicalURL={canonicalURL}
	/>
	<ViewTransitions />
	<body class="flex flex-col antialiased min-h-screen">
		<Header />
		<main
			class:list={`${container_max_w ?? "max-w-6xl"} flex-1 container mx-auto px-5`}
		>
			<div class="flex flex-col md:gap-20 md:py-20 gap-14 py-14">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
