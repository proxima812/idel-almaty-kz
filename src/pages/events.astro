---
import Layout from "@/layouts/Layout.astro";

import Container from "@/components/partials/Container.astro";
import { Content } from "@/data/pages/events.mdx";
---

<Layout title="Меропрития, клубы и кружки/занятия. Много полезного.">
	<Container>
		<h1 class="text-zinc-700 text-4xl font-bold">Меропрития, клубы и кружки/занятия</h1>
		<p
			class="my-6 text-green-700 bg-green-50 border border-green-400/50 px-3 py-1.5 rounded-md max-w-fit"
		>
			Уточняйте время и даты по <b>WhatsApp</b>!
		</p>
		<main class="prose prose-lg max-w-none prose-blue"><Content /></main>
	</Container>
</Layout>
