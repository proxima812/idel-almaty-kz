---
import About from "@/components/About.astro";
import Ggis2Btn from "@/components/Ggis2Btn.astro";
import MainTitle from "@/components/index/MainTitle.astro";
import InstagramBtn from "@/components/InstagramBtn.astro";
import LastCardNews from "@/components/LastCardNews.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
---

<Layout>
	<MainTitle />

	<!-- Подпишись, чтобы быть в курсе новостей 🔥 -->

	<section class="flex gap-2.5 justify-center flex-wrap">
		<p class="font-medium w-full text-center">Будь в курсе событий 🔥</p>

		<InstagramBtn href="https://www.instagram.com/idel_almaty_tatarskyi_centre" />
		<Ggis2Btn />
	</section>

	<!-- <section class="out-size">
  </section> -->
	<section>
		<span class="flex items-center justify-center gap-1 mb-6 text-zinc-600 font-medium">
			<Icon name="mdi:playlist-check" />Последние события центра</span
		>

		{/* Mobile */}
		<div class="block md:hidden">
			{
				posts &&
					posts.slice(0, 1).map((item) => <LastCardNews data={item.data} id={item.id} />)
			}
		</div>

		{/* Tablet / Desktop */}
		<div class="grid-cols-1 md:grid-cols-3 hidden md:grid">
			{
				posts &&
					posts.slice(0, 3).map((item) => <LastCardNews data={item.data} id={item.id} />)
			}
		</div>
	</section>

	<About />
</Layout>
