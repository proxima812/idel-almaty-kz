---
/**
 * Страница события по образцу heroui.com/blog/<post>: колонка 720px,
 * хлебные крошки, обложка в белой подложке, оглавление справа (xl),
 * похожие события и блок «Присоединяйся».
 */
import JoinBlock from "@/components/JoinBlock.astro";
import markdownui from "@/components/markdown";
import PostCard from "@/components/PostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
const post = Astro.props;
const { title, description, pubDate, heroImage } = post.data;

const posts = (await getCollection("posts"))
	.filter((item) => !item.data.draft)
	.sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const index = posts.findIndex((item) => item.id === post.id);
// «Похожие» — соседние по времени события, сначала более свежие.
const related = [...posts.slice(Math.max(0, index - 1), index), ...posts.slice(index + 1)].slice(0, 3);

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readTime = Math.max(1, Math.ceil(words / 190));
const year = pubDate.getFullYear();
const dateLabel = pubDate.toLocaleDateString("ru-RU", {
	day: "numeric",
	month: "long",
	year: "numeric",
});

const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const share = encodeURIComponent(currentUrl);
const shareText = encodeURIComponent(title);
const shareLinks = [
	{ label: "Telegram", icon: "mdi:telegram", href: `https://t.me/share/url?url=${share}&text=${shareText}` },
	{ label: "WhatsApp", icon: "mdi:whatsapp", href: `https://wa.me/?text=${shareText}%20${share}` },
];
---

<Layout
	{...post.data}
	type="Article"
	datePublished={pubDate.toISOString()}
	ogImage={heroImage?.src}
>
	<article>
		<div class="xl:grid xl:grid-cols-[1fr_minmax(0,720px)_1fr] xl:items-start xl:gap-x-8">
			<header class="contents">
				<div class="mx-auto flex max-w-180 flex-col gap-5 sm:gap-6 xl:col-start-2 xl:mx-0">
					<nav aria-label="Хлебные крошки" class="flex items-center gap-2 text-sm leading-5">
						<a class="text-zinc-500 transition-colors hover:text-zinc-900" href="/posts/">События</a>
						<Icon name="mdi:chevron-right" class="text-zinc-400" />
						<span aria-current="page" class="font-medium">{year}</span>
					</nav>
					<h1
						class="text-[34px] leading-9.5 font-medium tracking-[-0.02em] text-balance sm:text-5xl sm:leading-13.5"
					>
						{title}
					</h1>
					{
						description && (
							<p class="text-base leading-6.5 text-pretty text-zinc-500 sm:text-lg sm:leading-7.25">
								{description}
							</p>
						)
					}
					<p class="flex flex-wrap items-center gap-2 text-sm leading-5">
						<span
							class="grid size-5.5 shrink-0 place-items-center rounded-full bg-zinc-900 text-[10px] font-black text-white"
							aria-hidden="true">И</span
						>
						<span class="font-medium">Центр «Идел»</span>
						<span aria-hidden="true" class="px-1 text-zinc-400">·</span>
						<time class="text-zinc-500" datetime={pubDate.toISOString()}>{dateLabel}</time>
						<span aria-hidden="true" class="px-1 text-zinc-400">·</span>
						<span class="text-zinc-500">{readTime} мин чтения</span>
					</p>
				</div>

			{
				heroImage && (
					<div class="mx-auto mt-8 w-full max-w-220 xl:col-span-3 rounded-[28px] bg-zinc-50 p-1 shadow-[0_0_0_1px_#0000000a,0_1px_2px_0_#0000000a] max-sm:rounded-3xl sm:mt-10">
						<span class="relative block aspect-872/458 overflow-hidden rounded-3xl bg-zinc-100 max-sm:rounded-[20px]">
							<Image
								src={heroImage}
								alt=""
								width={1744}
								format="avif"
								loading="eager"
								class="absolute inset-0 size-full object-cover object-top"
							/>
						</span>
					</div>
				)
			}
			</header>

			<div class="post-body mx-auto mt-10 max-w-180 min-w-0 sm:mt-12 xl:col-start-2 xl:row-start-3 xl:mx-0">
				<Content components={markdownui} />
			</div>

			<aside class="hidden xl:sticky xl:top-28 xl:col-start-3 xl:row-start-3 xl:mt-12 xl:block xl:w-46">
				<div class="flex flex-col gap-3 pt-1">
					{
						toc.length > 0 && (
							<nav aria-labelledby="toc-heading">
								<p class="text-[13px] leading-5 font-medium" id="toc-heading">
									На этой странице
								</p>
								<ul class="mt-3 max-h-[calc(100svh-18rem)] overflow-y-auto [scrollbar-width:none]">
									{toc.map((h) => (
										<li>
											<a
												href={`#${h.slug}`}
												data-toc
												class:list={[
													"block border-l border-black/8 py-1.25 text-[13px] leading-4.5 text-zinc-500 transition-colors hover:text-zinc-900 data-active:border-zinc-900 data-active:text-zinc-900",
													h.depth === 3 ? "pl-6" : "pl-3",
												]}
											>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<div class="flex flex-col items-start gap-2 pt-3">
						<p class="text-[13px] leading-5 font-medium">Поделиться</p>
						{
							shareLinks.map((s) => (
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-1.5 text-[13px] text-zinc-500 transition-colors hover:text-zinc-900"
								>
									<Icon name={s.icon} />
									{s.label}
								</a>
							))
						}
						<button
							type="button"
							data-share-copy={currentUrl}
							class="flex cursor-pointer items-center gap-1.5 text-[13px] text-zinc-500 transition-colors hover:text-zinc-900"
						>
							<Icon name="mdi:link-variant" />
							<span data-share-copy-label>Копировать ссылку</span>
						</button>
					</div>
				</div>
			</aside>
		</div>

		<!-- Поделиться на мобильных/планшетах -->
		<div class="mx-auto mt-10 flex max-w-180 flex-wrap gap-2 xl:hidden">
			{
				shareLinks.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" class="btn btn-tertiary btn-sm">
						<Icon name={s.icon} />
						{s.label}
					</a>
				))
			}
			<button type="button" data-share-copy={currentUrl} class="btn btn-tertiary btn-sm">
				<Icon name="mdi:link-variant" />
				<span data-share-copy-label>Копировать ссылку</span>
			</button>
		</div>
	</article>

	{
		related.length > 0 && (
			<section aria-labelledby="related-posts-heading">
				<div class="mx-auto max-w-220">
					<h2 class="text-xl leading-7 font-medium tracking-[-0.01em]" id="related-posts-heading">
						Похожие события
					</h2>
					<ul class="mt-5 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
						{related.map((item) => (
							<li>
								<PostCard post={item} />
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<JoinBlock />

	<script>
		for (const button of document.querySelectorAll<HTMLButtonElement>("[data-share-copy]")) {
			button.addEventListener("click", async () => {
				const url = button.dataset.shareCopy;
				const label = button.querySelector<HTMLElement>("[data-share-copy-label]");
				if (!url) return;
				await navigator.clipboard.writeText(url);
				if (label) label.textContent = "Скопировано";
				setTimeout(() => {
					if (label) label.textContent = "Копировать ссылку";
				}, 1600);
			});
		}

		// Подсветка текущего раздела в оглавлении.
		const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
		if (links.length) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						for (const link of links) {
							link.toggleAttribute("data-active", link.hash === `#${entry.target.id}`);
						}
					}
				},
				{ rootMargin: "0px 0px -70% 0px" },
			);
			for (const link of links) {
				const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
				if (target) io.observe(target);
			}
		}
	</script>
</Layout>
