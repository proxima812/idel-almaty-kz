---
import BackLink from "@/components/BackLink.astro";
import InstagramBtn from "@/components/InstagramBtn.astro";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("stories");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
const post = Astro.props;
const { Content } = await render(post);
---

<Layout
	{...post.data}
	title=`Активист: ${post.data.title}`
	description={`История прихода в центр. ${post.data.title}, ${post.data.old}`}
>
	<div class="select-none w-4xl mx-auto max-w-full">
		<BackLink href="/stories/" />

		<aside
			class={`p-4 md:p-8 ${post.data.style} rounded-3xl border my-12 flex gap-6 items-center`}
		>
			{
				post.data.image && (
					<Image
						src={post.data.image}
						alt={`Изображения человека: ${post.data.title}`}
						format="avif"
						quality={"100"}
						class="rounded-2xl shadow-2xs w-30 md:w-50 h-30 md:h-50 object-cover"
						width={455}
						height={455}
					/>
				)
			}

			<div class="flex flex-col gap-3">
				<h1 class="text-2xl md:text-4xl font-bold">{post.data.title}</h1>
				<span class="text-xs md:text-sm">Добавлено: <b>{post.data.date}</b> </span>
				{
					post.data.inst && (
						<InstagramBtn
							href={post.data.inst}
							class="border gap-2 border-zinc-200 shadow-2xs bg-white text-zinc-800 hover:bg-white"
						/>
					)
				}
			</div>
		</aside>

		<main class="prose prose-blue xl:prose-xl lg:prose-lg prose-md">
			<Content />
		</main>
	</div>
</Layout>
