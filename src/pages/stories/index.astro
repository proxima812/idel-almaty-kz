---
import StoryCard from "@/components/StoryCard.astro"
import MainLayout from "@/layouts/MainLayout.astro"
import { getCollection } from "astro:content"

const stories = await getCollection("stories")
---

<MainLayout title="Личные истории активистов Татаро-Башкирского центра Идел">
	<section class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
		{stories && stories.map(item => <StoryCard data={item.data} slug={item.slug} />)}
	</section>
</MainLayout>
